# 发布构建（vite build / tauri build）使用的环境变量。
# 桌面端发布流程见 README「发布」与 docs/desktop-release-operations.md；
# GitHub Actions 从仓库 Variables / Secrets 注入，本文件仅作本地构建与字段说明。

# "true" 才允许客户端发起更新检查（src/services/updater.ts 判定 === "true"，
# 不要写成 TRUE / 1，也不要带空格）。同时决定发布配置里是否写入更新端点。
VITE_ENABLE_UPDATER=true

# ESA 边缘函数绑定的域名，必须只填 origin（不要带路径或结尾斜杠）。
# 授权服务与桌面更新服务共用它：写进 Tauri 更新端点的地址由构建脚本自动拼成
# {VITE_LICENSE_SERVER_URL}/api/desktop-updates/latest?platform={{target}}。
# 未配置时更新端点为空数组、会员状态退回本地缓存模式。
VITE_LICENSE_SERVER_URL=

# 授权响应 HMAC 验签密钥，须与 edge/config.js 的 HMAC_SECRET 一致。
# 与 VITE_LICENSE_SERVER_URL 必须同时配置，缺任一项授权服务都不生效。
VITE_LICENSE_RESPONSE_KEY=
