{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege desktop permissions for BVideo Studio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "os:allow-arch",
    "os:allow-platform",
    "store:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "process:allow-restart",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
